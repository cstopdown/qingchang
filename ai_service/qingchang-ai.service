[Unit]
Description=轻唱独立 CPU 音频评分服务
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/qingchang-ai/source
EnvironmentFile=/opt/qingchang-ai/worker.env
Environment=QINGCHANG_AI_BACKEND=transformers
Environment=QINGCHANG_AI_HOME=/opt/qingchang-ai
Environment=QINGCHANG_AI_MODEL_DIR=/root/models/MiniCPM-o-4_5
Environment=CUDA_VISIBLE_DEVICES=
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
Environment=OPENBLAS_NUM_THREADS=4
Environment=NUMEXPR_NUM_THREADS=4
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/qingchang-ai/venv/bin/python -m ai_service --host 127.0.0.1 --port 28787
CPUQuota=200%
MemoryMax=32G
Nice=10

[Install]
WantedBy=multi-user.target
