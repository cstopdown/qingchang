{
  "name": "qingchang",
  "productName": "轻唱",
  "version": "0.1.0",
  "private": true,
  "description": "轻唱：本地练唱、录音与作品管理",
  "author": "轻唱项目",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/install-desktop-runtime.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "desktop:pack": "npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "desktop:dist": "npm run build && electron-builder",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:check": "node scripts/ios.mjs check",
    "ios:build": "node scripts/ios.mjs build",
    "ios:run": "node scripts/ios.mjs run",
    "ai:setup": "node scripts/setup-ai.mjs",
    "ai:start": "node scripts/start-ai.mjs",
    "test:ai": "node scripts/test-ai.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "6.2.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.qingchang.app",
    "productName": "轻唱",
    "artifactName": "qingchang-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "ai_service",
        "to": "ai_service",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/.pytest_cache/**",
          "!**/*.pyc",
          "!tests/**"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "setup-ai.mjs",
          "start-ai.mjs"
        ]
      }
    ],
    "mac": {
      "icon": "electron/icons/icon.icns",
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "dir"
      ],
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "轻唱需要使用麦克风录制你的歌声。录音仅保存在本机。"
      }
    },
    "win": {
      "icon": "electron/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "轻唱"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
